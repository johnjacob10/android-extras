

prebuilt_etc {
    name: "privapp-permissions-org.fdroid.fdroid.privileged.xml",

    product_specific: true,

    src: "privapp-permissions-org.fdroid.fdroid.privileged.xml",
    relative_install_path: "permissions",
    product_specific: true,

}

android_app_import {

    name: "FDroidPrivilegedExtension",
    product_specific: true,

    privileged: true,

    certificate: "releasekey",
    required: ["privapp-permissions-org.fdroid.fdroid.privileged.xml"],
    apk: "org.fdroid.fdroid.privileged_2130.apk",

}
